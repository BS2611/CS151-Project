<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox styleClass="app-shell"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cs151.frontend.controller.TaskController">

    <fx:include source="sidebar-view.fxml"/>

    <VBox HBox.hgrow="ALWAYS" minWidth="0.0">

        <fx:include source="topbar-view.fxml"/>

        <ScrollPane styleClass="content-scroll"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    VBox.vgrow="ALWAYS">

            <HBox alignment="TOP_CENTER" minWidth="0.0">

                <VBox styleClass="page"
                      HBox.hgrow="ALWAYS"
                      maxWidth="1400.0"
                      minWidth="0.0">

                    <Button text="Back to Milestones"
                            onAction="#goBack"
                            styleClass="back-link"
                            contentDisplay="LEFT"
                            graphicTextGap="8.0">

                        <graphic>
                            <FontIcon iconLiteral="fas-arrow-left"/>
                        </graphic>
                    </Button>

                    <VBox spacing="6.0">
                        <Label text="Create a new task"
                               styleClass="page-title"/>

                        <Label text="Add a task to the selected milestone. Fields marked with * are required."
                               styleClass="page-subtitle"
                               wrapText="true"/>
                    </VBox>

                    <HBox styleClass="card, card-accent"
                          alignment="CENTER_LEFT"
                          spacing="24.0">

                        <VBox spacing="6.0"
                              HBox.hgrow="ALWAYS">

                            <HBox spacing="10.0"
                                  alignment="CENTER_LEFT">

                                <Label text="MILESTONE"
                                       styleClass="pill, pill-neutral"/>

                                <Label text="PARENT MILESTONE"
                                       styleClass="eyebrow"/>
                            </HBox>

                            <Label fx:id="summaryName"
                                   text="No milestone selected"
                                   styleClass="section-title"
                                   style="-fx-font-size: 20px;"
                                   wrapText="true"/>

                            <Label fx:id="summaryDeadline"
                                   text=""
                                   styleClass="helper-text"/>
                        </VBox>

                        <VBox spacing="6.0"
                              minWidth="250.0"
                              prefWidth="250.0"
                              alignment="CENTER_LEFT">

                            <Label text="TASK INFORMATION"
                                   styleClass="eyebrow"/>

                            <Label fx:id="summaryHint"
                                   text=""
                                   styleClass="helper-text"
                                   wrapText="true"/>
                        </VBox>
                    </HBox>

                    <VBox styleClass="card"
                          style="-fx-padding: 24 24 0 24;">

                        <Label text="Task Details"
                               styleClass="section-title"/>

                        <Pane styleClass="divider"/>

                        <VBox spacing="6.0">

                            <HBox spacing="3.0">
                                <Label text="Description"
                                       styleClass="field-label"/>
                                <Label text="*"
                                       styleClass="required-star"/>
                            </HBox>

                            <TextArea fx:id="descriptionField"
                                      promptText="Describe the work to complete"
                                      prefRowCount="4"
                                      wrapText="true"/>

                            <Label text="Enter a clear description for this task."
                                   styleClass="helper-text"/>
                        </VBox>

                        <HBox spacing="20.0">

                            <VBox spacing="6.0"
                                  HBox.hgrow="ALWAYS">

                                <HBox spacing="3.0">
                                    <Label text="Due Date"
                                           styleClass="field-label"/>
                                    <Label text="*"
                                           styleClass="required-star"/>
                                </HBox>

                                <DatePicker fx:id="dueDatePicker"
                                            promptText="Select a due date"
                                            maxWidth="Infinity"/>
                            </VBox>

                            <VBox spacing="6.0"
                                  HBox.hgrow="ALWAYS">

                                <HBox spacing="3.0">
                                    <Label text="Priority"
                                           styleClass="field-label"/>
                                    <Label text="*"
                                           styleClass="required-star"/>
                                </HBox>

                                <ComboBox fx:id="priorityComboBox"
                                          maxWidth="Infinity"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="6.0">

                            <HBox spacing="3.0">
                                <Label text="Status"
                                       styleClass="field-label"/>
                                <Label text="*"
                                       styleClass="required-star"/>
                            </HBox>

                            <ComboBox fx:id="statusComboBox"
                                      maxWidth="Infinity"
                                      prefWidth="250.0"  />
                        </VBox>

                        <HBox styleClass="card-footer"
                              alignment="CENTER_RIGHT"
                              spacing="12.0">

                            <VBox.margin>
                                <Insets left="-24"
                                        right="-24"/>
                            </VBox.margin>

                            <Button text="Cancel"
                                    onAction="#goBack"
                                    styleClass="secondary-button"/>

                            <Button text="Save Task"
                                    onAction="#saveTask"
                                    styleClass="primary-button"/>
                        </HBox>

                    </VBox>

                </VBox>

            </HBox>

        </ScrollPane>

    </VBox>

</HBox>