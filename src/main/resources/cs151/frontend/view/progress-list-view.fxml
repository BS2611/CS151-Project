<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox styleClass="app-shell"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cs151.frontend.controller.ProgressListController">

    <fx:include source="sidebar-view.fxml"/>

    <VBox HBox.hgrow="ALWAYS" minWidth="0.0">

        <fx:include source="topbar-view.fxml"/>

        <ScrollPane styleClass="content-scroll"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    VBox.vgrow="ALWAYS">

            <HBox alignment="TOP_CENTER" minWidth="0.0">

                <VBox styleClass="page"
                      HBox.hgrow="ALWAYS"
                      maxWidth="1400.0"
                      minWidth="0.0">

                    <Button text="Back to Tasks"
                            onAction="#goBack"
                            styleClass="back-link"
                            contentDisplay="LEFT"
                            graphicTextGap="8.0">
                        <graphic>
                            <FontIcon iconLiteral="fas-arrow-left"/>
                        </graphic>
                    </Button>

                    <VBox spacing="6.0">
                        <Label text="GOALS / MILESTONES / TASKS / PROGRESS"
                               styleClass="eyebrow"/>

                        <Label fx:id="titleLabel"
                               text="Progress"
                               styleClass="page-title"/>

                        <Label fx:id="subtitleLabel"
                               text="Progress entries sorted by entry date, ascending"
                               styleClass="page-subtitle"/>
                    </VBox>

                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Button minWidth="-Infinity"
                                text="Refresh"
                                onAction="#refreshEntries"
                                styleClass="secondary-button"/>
                    </HBox>

                    <VBox styleClass="card"
                          style="-fx-padding: 0;">

                        <TableView fx:id="progressTable"
                                   fixedCellSize="66.0">

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                            <columns>

                                <TableColumn fx:id="entryDateColumn"
                                             text="Entry Date"
                                             prefWidth="220.0"/>

                                <TableColumn fx:id="noteColumn"
                                             text="Note"
                                             prefWidth="700.0"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>

            </HBox>

        </ScrollPane>

    </VBox>

</HBox>