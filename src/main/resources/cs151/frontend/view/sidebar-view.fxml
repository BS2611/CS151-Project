<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox styleClass="sidebar"
      minWidth="234.0"
      prefWidth="234.0"
      maxWidth="234.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cs151.frontend.controller.SidebarController">

    <HBox fx:id="trafficLights" styleClass="traffic-lights" alignment="CENTER_LEFT" spacing="8.0" visible="false" managed="false">
        <Button fx:id="trafficClose" onAction="#closeWindow" styleClass="traffic, traffic-red" focusTraversable="false">
            <graphic><FontIcon iconLiteral="fas-times" styleClass="traffic-glyph"/></graphic>
        </Button>
        <Button fx:id="trafficMinimize" onAction="#minimizeWindow" styleClass="traffic, traffic-yellow" focusTraversable="false">
            <graphic><FontIcon iconLiteral="fas-minus" styleClass="traffic-glyph"/></graphic>
        </Button>
        <Button fx:id="trafficMaximize" onAction="#toggleMaximize" styleClass="traffic, traffic-green" focusTraversable="false">
            <graphic><FontIcon iconLiteral="fas-plus" styleClass="traffic-glyph"/></graphic>
        </Button>
    </HBox>

    <HBox fx:id="brandRow" alignment="CENTER_LEFT" spacing="10.0">
        <padding>
            <Insets top="0" right="0" bottom="18" left="6"/>
        </padding>
        <StackPane styleClass="brand-mark">
            <Label text="G" styleClass="brand-mark-text"/>
        </StackPane>
        <Label text="My Goal Tracker" styleClass="brand-name"/>
    </HBox>

    <Button fx:id="homeNav" text="Home" onAction="#openHome" styleClass="nav-item" contentDisplay="LEFT" graphicTextGap="12.0">
        <graphic><FontIcon iconLiteral="fas-home"/></graphic>
    </Button>
    <Button fx:id="goalsNav" text="Goals" onAction="#openGoals" styleClass="nav-item" contentDisplay="LEFT" graphicTextGap="12.0">
        <graphic><FontIcon iconLiteral="fas-flag"/></graphic>
    </Button>

    <Region VBox.vgrow="ALWAYS"/>

    <Label text="Goals &amp; milestones" styleClass="sidebar-footer"/>
</VBox>
