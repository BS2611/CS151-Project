<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER"
      spacing="15.0"
      prefHeight="550.0"
      prefWidth="700.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cs151.frontend.controller.MilestoneController">

    <padding>
        <Insets top="30.0" right="50.0" bottom="30.0" left="50.0"/>
    </padding>

    <Label text="Create Milestone"
           style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <Label text="Milestone Name"/>
    <TextField fx:id="milestoneNameField"
               promptText="Enter milestone name"
               maxWidth="350.0"/>

    <Label text="Target Date"/>
    <DatePicker fx:id="targetDatePicker"
                maxWidth="350.0"/>

    <Label text="Status"/>
    <ComboBox fx:id="statusComboBox"
              promptText="Select status"
              maxWidth="350.0"/>

    <Button text="Save" onAction="#saveMilestone"/>
    <Button text="Back" onAction="#goBack"/>

</VBox>
