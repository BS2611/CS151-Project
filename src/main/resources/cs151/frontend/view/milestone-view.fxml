<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true"
            prefHeight="600.0"
            prefWidth="700.0"
            style="-fx-background-color: #F4F7FB;"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="cs151.frontend.controller.MilestoneController"
>

    <content>
        <VBox alignment="TOP_CENTER"
              spacing="20.0"
              style="-fx-background-color: #F4F7FB;">

            <padding>
                <Insets top="30.0"
                        right="40.0"
                        bottom="30.0"
                        left="40.0"/>
            </padding>

            <!-- Page title -->
            <Label text="Create a new Milestone"
                   style="-fx-font-size: 28px;
                          -fx-font-weight: bold;
                          -fx-text-fill: #263238;"/>

            <!-- Required-field explanation -->
            <HBox alignment="CENTER" spacing="3.0">
                <Label text="Fields marked with a"/>
                <Label text="*"
                       textFill="#D32F2F"
                       style="-fx-font-weight: bold;"/>
                <Label text="are required"/>
            </HBox>

            <!-- Milestone form -->
            <GridPane hgap="15.0"
                      vgap="15.0"
                      maxWidth="560.0">

                <columnConstraints>
                    <ColumnConstraints minWidth="140.0"
                                       prefWidth="150.0"/>

                    <ColumnConstraints minWidth="300.0"
                                       prefWidth="400.0"
                                       hgrow="ALWAYS"/>
                </columnConstraints>

                <!-- Goal -->
                <HBox alignment="CENTER_LEFT"
                      spacing="3.0"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="0">

                    <Label text="Goal:"/>

                    <Label text="*"
                           textFill="#D32F2F"
                           style="-fx-font-weight: bold;"/>
                </HBox>

                <ComboBox fx:id="goalComboBox"
                          promptText="Select a goal"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="0"/>

                <!-- Milestone Name -->
                <HBox alignment="CENTER_LEFT"
                      spacing="3.0"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="1">

                    <Label text="Milestone Name:"/>

                    <Label text="*"
                           textFill="#D32F2F"
                           style="-fx-font-weight: bold;"/>
                </HBox>

                <TextField fx:id="milestoneNameField"
                           promptText="Enter a name that is unique within the goal"
                           GridPane.columnIndex="1"
                           GridPane.rowIndex="1"/>

                <!-- Target Date -->
                <HBox alignment="CENTER_LEFT"
                      spacing="3.0"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="2">

                    <Label text="Target Date:"/>

                    <Label text="*"
                           textFill="#D32F2F"
                           style="-fx-font-weight: bold;"/>
                </HBox>

                <DatePicker fx:id="targetDatePicker"
                            promptText="Not later than the goal's target date"
                            maxWidth="Infinity"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2"/>

                <!-- Status -->
                <HBox alignment="CENTER_LEFT"
                      spacing="3.0"
                      GridPane.columnIndex="0"
                      GridPane.rowIndex="3">

                    <Label text="Status:"/>

                    <Label text="*"
                           textFill="#D32F2F"
                           style="-fx-font-weight: bold;"/>
                </HBox>

                <ComboBox fx:id="statusComboBox"
                          maxWidth="Infinity"
                          GridPane.columnIndex="1"
                          GridPane.rowIndex="3"/>

            </GridPane>

            <!-- Validation or success message -->
            <Label fx:id="feedbackLabel"
                   text=""
                   wrapText="true"
                   maxWidth="560.0"
                   textFill="#C62828"/>

            <!-- Page buttons -->
            <HBox alignment="CENTER_RIGHT"
                  spacing="12.0"
                  maxWidth="560.0">

                <Button fx:id="backButton"
                        text="Back"
                        onAction="#goBack"
                        prefWidth="100.0"/>

                <Button fx:id="saveMilestoneButton"
                        text="Save"
                        prefWidth="140.0"
                        onAction="#saveMilestone"
                        style="-fx-background-color: #1976D2;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;"/>
            </HBox>

        </VBox>
    </content>
</ScrollPane>
