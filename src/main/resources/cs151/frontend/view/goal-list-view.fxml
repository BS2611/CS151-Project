<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox styleClass="app-shell"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cs151.frontend.controller.GoalListController">

    <fx:include source="sidebar-view.fxml"/>

    <VBox HBox.hgrow="ALWAYS" minWidth="0.0">
        <fx:include source="topbar-view.fxml"/>
        <ScrollPane styleClass="content-scroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <HBox alignment="TOP_CENTER" minWidth="0.0">
        <VBox styleClass="page" HBox.hgrow="ALWAYS" maxWidth="1400.0" minWidth="0.0">

            <HBox alignment="BOTTOM_LEFT" spacing="16.0">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="WORKSPACE / GOALS" styleClass="eyebrow"/>
                    <Label text="Goals" styleClass="page-title"/>
                    <Label text="Plan, organize, and track your long-term goals." styleClass="page-subtitle"/>
                </VBox>
                <HBox fx:id="summaryBox" styleClass="summary-strip" alignment="CENTER_LEFT" spacing="4.0"/>
                <Button minWidth="-Infinity" text="Create goal" onAction="#createGoal" styleClass="primary-button, primary-button-lg" contentDisplay="LEFT" graphicTextGap="10.0">
                    <graphic><FontIcon iconLiteral="fas-plus"/></graphic>
                </Button>
            </HBox>

            <VBox fx:id="toolbarCard" styleClass="toolbar-card" spacing="12.0">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <StackPane HBox.hgrow="ALWAYS" maxWidth="Infinity" alignment="CENTER_LEFT">
                        <TextField fx:id="searchField" promptText="Search goals, descriptions, categories..." styleClass="filter-search"/>
                        <FontIcon iconLiteral="fas-search" styleClass="field-icon" mouseTransparent="true" StackPane.alignment="CENTER_LEFT">
                            <StackPane.margin><Insets left="14"/></StackPane.margin>
                        </FontIcon>
                    </StackPane>
                    <ComboBox fx:id="statusFilter" minWidth="160.0" prefWidth="160.0"/>
                    <ComboBox fx:id="sortCombo" minWidth="230.0" prefWidth="230.0"/>
                </HBox>
                <FlowPane fx:id="categoryChips" hgap="8.0" vgap="8.0"/>
                <Pane styleClass="divider"/>
                <HBox fx:id="toolbarRow" alignment="CENTER_LEFT" spacing="10.0">
                    <HBox fx:id="hintBox" alignment="CENTER_LEFT" spacing="8.0" HBox.hgrow="ALWAYS" maxWidth="Infinity" minWidth="0.0">
                    <FontIcon iconLiteral="far-hand-pointer" styleClass="hint-icon"/>
                    <Label fx:id="messageLabel" text="Select a goal, then add or view its milestones. Double-click a row to open its milestones."
                           styleClass="helper-text" wrapText="true" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    </HBox>
                    <Button minWidth="-Infinity" text="Refresh" onAction="#refreshClicked" styleClass="secondary-button" contentDisplay="LEFT" graphicTextGap="8.0">
                        <graphic><FontIcon fx:id="refreshIcon" iconLiteral="fas-sync-alt"/></graphic>
                    </Button>
                    <Button minWidth="-Infinity" text="Create Milestone" onAction="#createMilestone" styleClass="secondary-button" contentDisplay="LEFT" graphicTextGap="8.0">
                        <graphic><FontIcon iconLiteral="fas-flag-checkered"/></graphic>
                    </Button>
                    <Button minWidth="-Infinity" text="View Milestones" onAction="#viewMilestones" styleClass="secondary-button" contentDisplay="LEFT" graphicTextGap="8.0">
                        <graphic><FontIcon iconLiteral="fas-list-ul"/></graphic>
                    </Button>
                </HBox>
            </VBox>

            <VBox styleClass="card" style="-fx-padding: 0;" VBox.vgrow="ALWAYS">
                <TableView fx:id="goalsTable" fixedCellSize="66.0">
                    <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                    <columns>
                        <TableColumn fx:id="nameColumn" minWidth="100.0" text="Goal" prefWidth="230.0"/>
                        <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="190.0" visible="false"/>
                        <TableColumn fx:id="categoryColumn" minWidth="92.0" text="Category" prefWidth="100.0"/>
                        <TableColumn fx:id="targetDateColumn" minWidth="142.0" text="Target Date" prefWidth="140.0"/>
                        <TableColumn fx:id="statusColumn" minWidth="128.0" text="Status" prefWidth="140.0"/>
                        <TableColumn fx:id="progressColumn" minWidth="100.0" text="Progress" prefWidth="120.0"/>
                        <TableColumn fx:id="milestonesColumn" minWidth="120.0" text="Milestones" prefWidth="130.0"/>
                        <TableColumn fx:id="actionsColumn" minWidth="70.0" text="Actions" prefWidth="80.0" sortable="false"/>
                    </columns>
                </TableView>

                <HBox styleClass="table-footer" alignment="CENTER_LEFT" spacing="10.0">
                    <Label fx:id="countLabel" text="" styleClass="footer-strong"/>
                    <Label text="•" styleClass="helper-text"/>
                    <HBox alignment="CENTER_LEFT" spacing="6.0">
                        <FontIcon iconLiteral="fas-check-circle" styleClass="stored-icon"/>
                        <Label text="100% stored locally" styleClass="stored-local"/>
                    </HBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Rows per page:" styleClass="footer-strong"/>
                    <ComboBox fx:id="rowsPerPageCombo" prefWidth="80.0"/>
                    <Button fx:id="previousButton" minWidth="-Infinity" text="Previous" onAction="#previousPage" styleClass="page-button"/>
                    <Button fx:id="nextButton" minWidth="-Infinity" text="Next" onAction="#nextPage" styleClass="page-button"/>
                </HBox>
            </VBox>

        </VBox>
        </HBox>
        </ScrollPane>
    </VBox>
</HBox>
