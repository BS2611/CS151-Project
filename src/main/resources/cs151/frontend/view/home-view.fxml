<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox styleClass="app-shell"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cs151.frontend.controller.HomeController">

    <fx:include source="sidebar-view.fxml"/>

    <VBox HBox.hgrow="ALWAYS" minWidth="0.0">
        <fx:include source="topbar-view.fxml"/>
        <ScrollPane styleClass="content-scroll" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS">
        <HBox alignment="TOP_CENTER" minWidth="0.0">
        <VBox styleClass="page" HBox.hgrow="ALWAYS" maxWidth="1400.0" minWidth="0.0">

            <HBox alignment="BOTTOM_LEFT" spacing="16.0">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="WORKSPACE / HOME" styleClass="eyebrow"/>
                    <Label text="Personal Goal Planner" styleClass="page-title"/>
                    <Label text="Create and manage your personal goals and the milestones that lead to them." styleClass="page-subtitle" wrapText="true"/>
                </VBox>
                <Label fx:id="dateChip" text="Today" styleClass="date-chip" minWidth="-Infinity"/>
            </HBox>

            <HBox spacing="20.0">
                <VBox styleClass="action-card" HBox.hgrow="ALWAYS" onMouseClicked="#openGoalPage">
                    <Label text="Create a goal" styleClass="section-title"/>
                    <Label text="Define a long-term goal with a category, target date and starting status."
                           styleClass="page-subtitle" wrapText="true"/>
                    <Button minWidth="-Infinity" fx:id="goalButton" text="Create Goal" onAction="#openGoalPage" styleClass="primary-button"/>
                </VBox>

                <VBox styleClass="action-card" HBox.hgrow="ALWAYS" onMouseClicked="#openGoalListPage">
                    <Label text="Your goals" styleClass="section-title"/>
                    <Label text="Browse every goal, then add milestones or review the ones you already have."
                           styleClass="page-subtitle" wrapText="true"/>
                    <Button minWidth="-Infinity" fx:id="viewGoalsButton" text="List Goals" onAction="#openGoalListPage" styleClass="secondary-button"/>
                </VBox>
            </HBox>

        </VBox>
        </HBox>
        </ScrollPane>
    </VBox>
</HBox>
