<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox fx:id="topbar" styleClass="topbar" alignment="CENTER_LEFT" spacing="16.0" minWidth="0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cs151.frontend.controller.TopbarController">

    <HBox fx:id="crumbBox" alignment="CENTER_LEFT" spacing="8.0" HBox.hgrow="ALWAYS" minWidth="-Infinity"/>

    <StackPane prefWidth="260.0" minWidth="80.0" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Search goals..." styleClass="topbar-search" onAction="#search"/>
        <FontIcon iconLiteral="fas-search" styleClass="field-icon" mouseTransparent="true" StackPane.alignment="CENTER_LEFT">
            <StackPane.margin><Insets left="14"/></StackPane.margin>
        </FontIcon>
    </StackPane>

    <HBox fx:id="userChip" styleClass="user-chip" alignment="CENTER_LEFT" spacing="10.0" minWidth="-Infinity">
        <StackPane styleClass="avatar">
            <Label text="B" styleClass="avatar-text"/>
        </StackPane>
        <VBox spacing="0.0">
            <Label text="User" styleClass="user-name"/>
            <Label text="Personal Workspace" styleClass="user-sub"/>
        </VBox>
    </HBox>

    <HBox fx:id="windowButtons" styleClass="window-buttons" alignment="CENTER" spacing="2.0" minWidth="-Infinity">
        <Button fx:id="minimizeButton" onAction="#minimize" styleClass="win-btn" focusTraversable="false">
            <graphic><Region styleClass="icon-min"/></graphic>
        </Button>
        <Button fx:id="maximizeButton" onAction="#toggleMaximize" styleClass="win-btn" focusTraversable="false">
            <graphic><Region fx:id="maxIcon" styleClass="icon-max"/></graphic>
        </Button>
        <Button fx:id="closeButton" onAction="#close" styleClass="win-btn, win-close" focusTraversable="false">
            <graphic><Region styleClass="icon-close"/></graphic>
        </Button>
    </HBox>
</HBox>
