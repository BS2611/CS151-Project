<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<HBox styleClass="app-shell"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="cs151.frontend.controller.TaskListController">

    <fx:include source="sidebar-view.fxml"/>

    <VBox HBox.hgrow="ALWAYS" minWidth="0.0">

        <fx:include source="topbar-view.fxml"/>

        <ScrollPane styleClass="content-scroll"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    VBox.vgrow="ALWAYS">

            <HBox alignment="TOP_CENTER" minWidth="0.0">

                <VBox styleClass="page"
                      HBox.hgrow="ALWAYS"
                      maxWidth="1400.0"
                      minWidth="0.0">

                    <Button text="Back to Milestones"
                            onAction="#goBack"
                            styleClass="back-link"
                            contentDisplay="LEFT"
                            graphicTextGap="8.0">
                        <graphic>
                            <FontIcon iconLiteral="fas-arrow-left"/>
                        </graphic>
                    </Button>

                    <VBox spacing="6.0">
                        <Label text="GOALS / MILESTONES / TASKS"
                               styleClass="eyebrow"/>

                        <Label fx:id="titleLabel"
                               text="Tasks"
                               styleClass="page-title"/>

                        <Label fx:id="subtitleLabel"
                               text="Tasks sorted by due date, ascending"
                               styleClass="page-subtitle"/>
                    </VBox>
                    <!-- Opens the progress history for the selected task. -->
                    <HBox alignment="CENTER_RIGHT" spacing="10.0">
                        <Button minWidth="-Infinity"
                                text="View Progress"
                                onAction="#viewProgress"
                                styleClass="secondary-button"/>
                    </HBox>

                    <VBox styleClass="card"
                          style="-fx-padding: 0;">

                        <TableView fx:id="tasksTable"
                                   fixedCellSize="66.0">

                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                            </columnResizePolicy>

                            <columns>

                                <TableColumn fx:id="descriptionColumn"
                                             text="Description"
                                             prefWidth="400.0"/>

                                <TableColumn fx:id="dueDateColumn"
                                             text="Due Date"
                                             prefWidth="180.0"/>

                                <TableColumn fx:id="priorityColumn"
                                             text="Priority"
                                             prefWidth="160.0"/>

                                <TableColumn fx:id="statusColumn"
                                             text="Status"
                                             prefWidth="160.0"/>

                            </columns>

                        </TableView>

                    </VBox>

                </VBox>

            </HBox>

        </ScrollPane>

    </VBox>

</HBox>